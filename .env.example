# Copie para .env e preencha. O .env não vai para o git.

# Agente (Google AI Studio). Na Vercel: Settings > Environment Variables.
GEMINI_API_KEY=
# Opcional. Se o modelo principal estiver sobrecarregado, o agente cai para gemini-3.5-flash.
GEMINI_MODEL=gemini-3.8-flash

# GoodData Cloud (provisionamento e servidor MCP)
GOODDATA_HOST=https://sua-org.cloud.gooddata.com
GOODDATA_TOKEN=
GOODDATA_WORKSPACE=museus_br

# Destino que o GoodData lê: motherduck | postgres
GD_DESTINO=motherduck
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=museus_br
# GD_PG_URL=postgresql://usuario:senha@host:5432/banco

# BigQuery (target opcional do dbt)
# GCP_PROJECT=
# MUSEUS_GCS_BUCKET=
